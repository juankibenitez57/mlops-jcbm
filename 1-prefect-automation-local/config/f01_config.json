{
    "project": "titanic-mlops",
    "job_type": "monolith-train",
    "artifact_name": "titanic_raw",
    "artifact_version": "latest",
    "dataset_filename": "titanic_raw.csv",
    "drop_columns": ["PassengerId", "Name", "Ticket", "Cabin"],
    "target": "Survived",
    "features": [
        "Pclass", "Sex", "Age", "SibSp", "Parch",
        "Fare", "Embarked", "FamilySize", "IsAlone", "FarePerPerson"
    ],
    "model_artifact_name": "titanic-rf-monolith",
    "model_artifact_type": "model",
    "n_estimators": 100,
    "max_depth": 8,
    "test_size": 0.2,
    "random_state": 42
}
